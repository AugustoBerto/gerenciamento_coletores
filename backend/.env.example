NODE_ENV=development
PORT=3131

# Conexão Padronizada via DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Chave compartilhada com o dass_auth_service para validação de JWTs
JWT_SECRET=dass-auth-local-development-jwt-secret-2026

# Serviço central de autenticação DASS (roteado pelo API Gateway na porta 2399)
DASS_AUTH_URL=http://127.0.0.1:2399/api

# Origens CORS permitidas
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:2399,http://127.0.0.1:2399,http://127.0.0.1:5173,http://127.0.0.1:5174

NODE_ENV=development
PORT=3050

# Conexão Padronizada via DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Chave compartilhada com o dass_auth_service para validação de JWTs
JWT_SECRET=sua-chave-secreta-jwt-aqui

# Serviço central de autenticação DASS (acesso interno)
DASS_AUTH_URL=http://127.0.0.1:2123

# Origens CORS permitidas
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:2399,http://127.0.0.1:2399,http://127.0.0.1:5173
